{
  "manifest_version": 3,
  "name": "ChatGPT 聊天白名单助手",
  "version": "0.2.0",
  "description": "在 ChatGPT 页面框选聊天加入白名单；关键词保护、预览候选与 CSV 导出。当前不执行删除或归档。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "action": {"default_title": "ChatGPT 聊天白名单助手", "default_popup": "popup.html"}
}
